{
  "name": "forge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/run.mts",
    "eval": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/eval-retrieval.mts",
    "cost": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/project-cost.mts",
    "verify": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-live.mts",
    "e2e": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e.mts",
    "hooks": "git config core.hooksPath .githooks && echo 'hooks installed: .githooks (pre-push runs pnpm check)'",
    "warm": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/warm.mts",
    "check": "node --conditions=react-server --import ./tests/resolver.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@xenova/transformers": "2.17.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}
